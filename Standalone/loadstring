-- GunTesting Lite standalone loader V8
-- Confirmed GunTesting structure: Workspace > Players > botName > Humanoid / HumanoidRootPart.
-- Bot ESP has NO minimum/maximum distance filter: if the bot model is replicated in Workspace.Players and is on-screen, ESP may render.

if shared.GunTestingLiteStandaloneV8 == "loaded" then
    local CoreGui=game:GetService("CoreGui")
    local parent=(gethui and gethui()) or CoreGui
    local gui=parent:FindFirstChild("GunTestingLiteV1",true)
    if gui then
        local title
        for _,d in ipairs(gui:GetDescendants()) do
            if d:IsA("TextLabel") and tostring(d.Text):find("GUN TESTING LITE",1,true) then title=d; break end
        end
        local main=title and title.Parent and title.Parent.Parent
        if main and main:IsA("Frame") then main.Visible=not main.Visible end
    end
    return
end
if shared.GunTestingLiteStandaloneV8 == "loading" then return end
shared.GunTestingLiteStandaloneV8="loading"

local BASE="https://raw.githubusercontent.com/Lvk777/yokai/refs/heads/custom/curated-yokai-final/Standalone/"
local CoreGui=game:GetService("CoreGui")
local parent=(gethui and gethui()) or CoreGui

for _,name in ipairs({
    "GunTestingLiteV1","GunTestingLiteOverlay","GunTestingLiteSnaplinesV2",
    "GunTestingLiteMapESPV4","GunTestingLitePracticeV5","GunTestingLiteDirectBotsV6",
    "GunTestingLiteSelfESPTest","GunTestingLiteSelfESPLabel","GunTestingLiteBotProbe","GunTestingLiteBotProbeLabel"
}) do
    local old=parent:FindFirstChild(name,true)
    if old then pcall(function() old:Destroy() end) end
end

shared.GunTestingLiteStandaloneV5=nil
shared.GunTestingLiteStandaloneV6=nil
shared.GunTestingLiteStandaloneV7=nil
shared.GunTestingLiteV1=nil
shared.GunTestingLiteExtrasV2=nil
shared.GunTestingLiteUIPolishV3=nil
shared.GunTestingLiteMapESPV4=nil
shared.GunTestingLiteMovementV4=nil
shared.GunTestingLitePracticeV5=nil
shared.GunTestingLiteWorldStabilizerV3=nil
shared.GunTestingLiteDirectBotsV6=nil
shared.GunTestingLiteESPDiagnosticsV7=nil

local function runFile(name,transform)
    local ok,err=pcall(function()
        local src=game:HttpGet(BASE..name,true)
        if transform then src=transform(src) end
        local fn,compileErr=loadstring(src)
        if not fn then error(compileErr or ("compile failed: "..name)) end
        fn()
    end)
    if not ok then warn("[GunTestingLite] "..name.." failed: "..tostring(err)) end
    return ok
end

local baseOk=runFile("GunTestingLiteV1.lua",function(src)
    src=src:gsub("tabs%.Combat:Activate%(%)","")
    src=src:gsub(
        "if i%.KeyCode==Enum%.KeyCode%.RightShift then Main%.Visible=not Main%.Visible end",
        "-- RightShift handled by GunTestingLiteUIPolishV3"
    )
    src=src:gsub('print%(%"%[GunTestingLite%] loaded%"%)',"")
    return src
end)
if not baseOk then shared.GunTestingLiteStandaloneV8=nil; return end

runFile("GunTestingLiteWorldStabilizerV3.lua")
runFile("GunTestingLiteUIPolishV3.lua")

-- V6 still owns Combat/Visuals, but the visual distance gate is removed at load time.
runFile("GunTestingLiteDirectBotsV6.lua",function(src)
    -- Remove the Visuals max-distance input so there is no artificial ESP range control.
    src=src:gsub('number%(Visuals,%"Max Distance%",V,%"MaxDistance%",100,100000%)','')
    -- Remove the actual range rejection. Bounds/on-screen checks remain because screen-space boxes need a viewport position.
    src=src:gsub('if not V%.Enabled or not tl or dist>V%.MaxDistance then hide%(s%) continue end','if not V.Enabled or not tl then hide(s) continue end')
    -- Make the UI explicit about the behavior.
    src=src:gsub('Direct Workspace%.Players ESP V6','Direct Workspace.Players ESP V8 - NO DISTANCE LIMIT')
    return src
end)

runFile("GunTestingLiteESPDiagnosticsV7.lua")
runFile("GunTestingLiteMovementV4.lua")

shared.GunTestingLiteStandaloneV8="loaded"
