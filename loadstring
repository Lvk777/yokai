-- Recognize the bot-practice profile from either world folders OR the replicated
-- client weapon framework. This prevents the final controls from being skipped
-- when Workspace folders stream in later than the loader.
local function hasClientGunSystem()
    local ps=lp and lp:FindFirstChild("PlayerScripts")
    local client=ps and ps:FindFirstChild("Client")
    local systems=client and client:FindFirstChild("Systems")
    return systems and systems:FindFirstChild("GunSystem")~=nil
end
local function hasWeaponTool()
    local backpack=lp and lp:FindFirstChildOfClass("Backpack")
    if not backpack then return false end
    for _,obj in ipairs(backpack:GetChildren()) do
        if obj:IsA("Tool") and (obj:FindFirstChild("WeaponConfig") or obj:FindFirstChild("Ammo")) then return true end
    end
    return false
end
local function botProfileReady()
    return Workspace:FindFirstChild("Zombies")~=nil
        or Workspace:FindFirstChild("WeaponSystem_Workspace")~=nil
        or hasClientGunSystem()
        or hasWeaponTool()
end
local function vehicleProfileReady()
    return Workspace:FindFirstChild("Vehicles")~=nil
end
if not botProfileReady() and not vehicleProfileReady() then
    local deadline=os.clock()+15
    repeat task.wait(.15) until botProfileReady() or vehicleProfileReady() or os.clock()>=deadline
end

-- Preserve the user's currently-open main windows before the profile patch stack.
pcall(function()
    local gl=shared.GuiLibrary
    local objs=gl and gl.ObjectsThatCanBeSaved
    if not objs then return end
    local state={}
    for _,name in ipairs({"Combat","Movement","Render","Utility","Visuals","World"}) do
        local rec=objs[name.."Window"]
        local obj=rec and rec.Object
        if obj and typeof(obj)=="Instance" then state[name]=obj.Visible==true end
    end
    shared.YokaiPreBotWindowState=state
end)

