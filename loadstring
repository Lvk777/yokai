local BASE = "https://raw.githubusercontent.com/Lvk777/yokai/refs/heads/custom/curated-yokai-final/"
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local function load(name)
    local ok,err=pcall(function()
        local src=game:HttpGet(BASE .. name, true)
        local fn,compileErr=loadstring(src)
        if not fn then error(compileErr or ("compile failed: "..name)) end
        fn()
    end)
    if not ok then warn("[Yokai loader] "..name.." failed: "..tostring(err)) end
    return ok,err
end

-- Keep legacy hook APIs unavailable while the base/curated module set is created.
-- This prevents old kick/namecall modules from installing themselves; it does not
-- attempt to bypass or hide from game-side protections.
local env=(getgenv and getgenv()) or _G
local hookKeys={"hookmetamethod","getnamecallmethod","getrawmetatable","setreadonly","make_writeable","hookfunction"}
local originalHooks={}
for _,key in ipairs(hookKeys) do
    local ok,value=pcall(function() return env[key] end)
    if ok and value~=nil then originalHooks[key]=value end
    pcall(function() env[key]=nil end)
end

load("main.lua")
load("NotificationHygieneEarly.lua")

local lp=Players.LocalPlayer
local function hasClientGunSystem()
    local ps=lp and lp:FindFirstChild("PlayerScripts")
    local client=ps and ps:FindFirstChild("Client")
    local systems=client and client:FindFirstChild("Systems")
    return systems and systems:FindFirstChild("GunSystem")~=nil
end
local function hasWeaponTool()
    local backpack=lp and lp:FindFirstChildOfClass("Backpack")
    if not backpack then return false end
    for _,obj in ipairs(backpack:GetChildren()) do
        if obj:IsA("Tool") and (obj:FindFirstChild("WeaponConfig") or obj:FindFirstChild("Ammo")) then return true end
    end
    return false
end
local function botProfileReady()
    return Workspace:FindFirstChild("Zombies")~=nil
        or Workspace:FindFirstChild("WeaponSystem_Workspace")~=nil
        or hasClientGunSystem()
        or hasWeaponTool()
end
local function vehicleProfileReady()
    return Workspace:FindFirstChild("Vehicles")~=nil
end

-- Decide the bootstrap BEFORE loading the old patch stack. This is the important
-- change: bot maps never execute CuratedBootstrap's long chain of delayed visual/UI
-- replacements, which was restoring the legacy menu after the custom one appeared.
if not botProfileReady() and not vehicleProfileReady() then
    local deadline=os.clock()+15
    repeat task.wait(.15) until botProfileReady() or vehicleProfileReady() or os.clock()>=deadline
end
local isBotProfile=botProfileReady()

if isBotProfile then
    load("BotLeanBootstrapV12.lua")
else
    load("CuratedBootstrap.lua")
end

load("DisableUnsafeClientHooks.lua")
load("DisableLiveSilentAim.lua")

for _,key in ipairs(hookKeys) do
    local value=originalHooks[key]
    pcall(function() env[key]=value end)
end

-- Small common local utilities only.
load("SimpleAntiFlingFinal.lua")
load("UniversalMovementV2.lua")
load("LocalNoclip.lua")

-- Synthetic target polish belongs to Studio only. It is intentionally not loaded
-- in the live bot profile anymore.
if RunService:IsStudio() and not isBotProfile then
    load("SafeTargetAllInOne.lua")
    load("SafeTargetPolishFinal.lua")
    load("SafeTargetESPFinal.lua")
    load("SafeTargetVisualsUXV2.lua")
    load("FinalVisualPolishV4.lua")
end

-- Older Gun Testing profile is separate from the current WeaponSystem bot map.
local playerScripts=lp and lp:FindFirstChild("PlayerScripts")
local gunController=playerScripts and playerScripts:FindFirstChild("GunController")
local gunEvents=gunController and gunController:FindFirstChild("Events")
local gunPlugin=gunEvents and gunEvents:FindFirstChild("GunPlugin")
local isGunTesting=(not isBotProfile) and lp and lp:FindFirstChild("GunInventory")~=nil and gunPlugin~=nil
if isGunTesting then
    load("GunTestingRuntimePolish.lua")
    load("GunTestingSafeUXV4.lua")
end

-- Preserve the currently-open main windows before final bot replacements.
if isBotProfile then
    pcall(function()
        local gl=shared.GuiLibrary
        local objs=gl and gl.ObjectsThatCanBeSaved
        if not objs then return end
        local state={}
        for _,name in ipairs({"Combat","Movement","Render","Utility","Visuals","World"}) do
            local rec=objs[name.."Window"]
            local obj=rec and rec.Object
            if obj and typeof(obj)=="Instance" then state[name]=obj.Visible==true end
        end
        shared.YokaiPreBotWindowState=state
    end)
end

if vehicleProfileReady() then load("VehicleMapPerformanceV1.lua") end

if isBotProfile then
    -- One deterministic stack. Older V4/V6 menu owners are deliberately omitted;
    -- V8/V9/V10 supersede those jobs and V5 owns the WeaponSystem controls.
    load("OwnerBotPracticeRuntimeV2.lua")
    load("OwnerBotAimVisualUXV3.lua")
    load("OwnerBotDamageNotificationsV7.lua")
    load("FullBrightnessFinalV8.lua")
    load("FinalMenuPerformanceV9.lua")
    load("OwnerBotWeaponAndMenuV5.lua")
    load("FinalMenuPinV10.lua")
    load("StableCustomMenuSnapshotV13.lua")
end
