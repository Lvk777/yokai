-- Hard session guard: main.lua already protects itself, but without this guard every
-- later patch could still be executed again if the loader was run twice in one Roblox session.
if shared.YokaiCuratedStackV18 then
    return
end
shared.YokaiCuratedStackV18="loading"

local RunService=game:GetService("RunService")
local BASE = "https://raw.githubusercontent.com/Lvk777/yokai/refs/heads/custom/curated-yokai-final/"
loadstring(game:HttpGet(BASE .. "main.lua", true))()

-- Quiet the bootstrap before the patch stack starts emitting status toasts.
loadstring(game:HttpGet(BASE .. "NotificationHygieneEarly.lua", true))()

loadstring(game:HttpGet(BASE .. "CuratedBootstrap.lua", true))()
loadstring(game:HttpGet(BASE .. "SimpleAntiFlingFinal.lua", true))()

-- SafeTarget is a Preview/Studio-only stack. Keeping it out of live Gun Testing
-- avoids several extra GUIs/connections while preserving every feature in Studio.
if RunService:IsStudio() then
    loadstring(game:HttpGet(BASE .. "SafeTargetAllInOne.lua", true))()
    loadstring(game:HttpGet(BASE .. "SafeTargetPolishFinal.lua", true))()
    loadstring(game:HttpGet(BASE .. "SafeTargetESPFinal.lua", true))()
    loadstring(game:HttpGet(BASE .. "SafeTargetVisualsUXV2.lua", true))()
end

loadstring(game:HttpGet(BASE .. "UniversalMovementV2.lua", true))()
loadstring(game:HttpGet(BASE .. "LocalNoclip.lua", true))()
loadstring(game:HttpGet(BASE .. "FinalVisualPolishV4.lua", true))()
loadstring(game:HttpGet(BASE .. "BotArenaAdapter.lua", true))()
loadstring(game:HttpGet(BASE .. "GunTestingRuntimePolish.lua", true))()
loadstring(game:HttpGet(BASE .. "GunTestingAimViewmodelV2.lua", true))()

-- Preserved extras, event-driven/throttled for lower UI/runtime overhead.
loadstring(game:HttpGet(BASE .. "PreservedLocalExtrasV15.lua", true))()

-- Rebuild the requested bot-practice Combat on top of the known-good V3 baseline.
loadstring(game:HttpGet(BASE .. "GunTestingCombatResetV16.lua", true))()
loadstring(game:HttpGet(BASE .. "GunTestingPluginIntegrationV3.lua", true))()
loadstring(game:HttpGet(BASE .. "GunTestingCombatFinalV16.lua", true))()

-- Useful gameplay feedback only: bot damage, hitmarker and bot inventory support.
loadstring(game:HttpGet(BASE .. "QuietBotFeedbackV17.lua", true))()

-- Final adapter replaces only Aimbot, Fly and Inventory Viewer with the lightweight
-- versions adapted from the user-provided LvkHub reference.
loadstring(game:HttpGet(BASE .. "LvkReferenceBotAdaptersV18.lua", true))()

shared.YokaiCuratedStackV18="loaded"
