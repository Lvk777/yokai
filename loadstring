local BASE = "https://raw.githubusercontent.com/Lvk777/yokai/refs/heads/custom/curated-yokai-final/"
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local function load(name)
    local ok,err=pcall(function()
        local src=game:HttpGet(BASE .. name, true)
        local fn,compileErr=loadstring(src)
        if not fn then error(compileErr or ("compile failed: "..name)) end
        fn()
    end)
    if not ok then warn("[Yokai loader] "..name.." failed: "..tostring(err)) end
    return ok,err
end

-- Compatibility loading mode: temporarily hide executor hook APIs while the base
-- GUI/module pack is being created. This prevents saved legacy modules such as
-- ClientKickDisable/SilentAim from installing __namecall hooks during startup.
local env = (getgenv and getgenv()) or _G
local hookKeys = {"hookmetamethod","getnamecallmethod","getrawmetatable","setreadonly","make_writeable","hookfunction"}
local originalHooks = {}
for _,key in ipairs(hookKeys) do
    local ok,value=pcall(function() return env[key] end)
    if ok and value~=nil then originalHooks[key]=value end
    pcall(function() env[key]=nil end)
end

load("main.lua")
-- Install the notification filter before the patch stack so repetitive
-- "... loaded" notices never flood the right side of the screen.
load("NotificationHygieneEarly.lua")
load("CuratedBootstrap.lua")
load("DisableUnsafeClientHooks.lua")
load("DisableLiveSilentAim.lua")

-- Restore the executor environment after Yokai's legacy modules have been removed.
for _,key in ipairs(hookKeys) do
    local value=originalHooks[key]
    pcall(function() env[key]=value end)
end

load("SimpleAntiFlingFinal.lua")
load("UniversalMovementV2.lua")
load("LocalNoclip.lua")
load("FinalVisualPolishV4.lua")

-- Synthetic target layers are test tools; do not load their extra render loops in normal games.
if RunService:IsStudio() then
    load("SafeTargetAllInOne.lua")
    load("SafeTargetPolishFinal.lua")
    load("SafeTargetESPFinal.lua")
    load("SafeTargetVisualsUXV2.lua")
end

-- Gun Testing passive/local profile.
local lp=Players.LocalPlayer
local playerScripts=lp and lp:FindFirstChild("PlayerScripts")
local gunController=playerScripts and playerScripts:FindFirstChild("GunController")
local gunEvents=gunController and gunController:FindFirstChild("Events")
local gunPlugin=gunEvents and gunEvents:FindFirstChild("GunPlugin")
local isGunTesting=(lp and lp:FindFirstChild("GunInventory")~=nil and gunPlugin~=nil)
if isGunTesting then
    load("GunTestingRuntimePolish.lua")
    load("GunTestingSafeUXV4.lua")
end

-- Some experiences stream/map-build these folders after the player joins. Waiting
-- here prevents the bot profile from being skipped simply because the loader ran
-- a fraction of a second too early.
local function botProfileReady()
    return Workspace:FindFirstChild("Zombies")~=nil or Workspace:FindFirstChild("WeaponSystem_Workspace")~=nil
end
local function vehicleProfileReady()
    return Workspace:FindFirstChild("Vehicles")~=nil
end
if not botProfileReady() and not vehicleProfileReady() then
    local deadline=os.clock()+12
    repeat
        task.wait(.15)
    until botProfileReady() or vehicleProfileReady() or os.clock()>=deadline
end

if vehicleProfileReady() then
    load("VehicleMapPerformanceV1.lua")
end

-- Owner bot/weapon practice profile. Final layers are intentionally loaded in a
-- deterministic order. V5 integrates with this WeaponSystem; V6 only fixes menu
-- visibility/scroll/subcontrol ordering. V7 restores concise damage/part feedback.
if botProfileReady() then
    load("OwnerBotPracticeRuntimeV2.lua")
    load("OwnerBotAimVisualUXV3.lua")
    load("OwnerBotVisualPolishV4.lua")
    local ok=load("OwnerBotWeaponAndMenuV5.lua")
    if not ok then
        task.wait(.6)
        load("OwnerBotWeaponAndMenuV5.lua")
    end
    load("OwnerBotMenuVisibilityV6.lua")
    load("OwnerBotDamageNotificationsV7.lua")
    -- Must be the last visual owner: this disables every older Fullbright control
    -- and writes the final Lighting state after the game's own day/night pass.
    load("FullBrightnessFinalV8.lua")
end
