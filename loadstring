-- Fault-tolerant curated loader. The complete stack runs once per Roblox process.
if shared.YokaiCuratedStackV19 == "loaded" or shared.YokaiCuratedStackV19 == "loading" then
    return
end
shared.YokaiCuratedStackV19 = "loading"

local BASE = "https://raw.githubusercontent.com/Lvk777/yokai/refs/heads/custom/curated-yokai-final/"
local failures = {}
local function safeLoad(name)
    local ok, err = pcall(function()
        local src = game:HttpGet(BASE .. name, true)
        local fn, compileErr = loadstring(src)
        if not fn then error(compileErr or ("compile failed: " .. name)) end
        fn()
    end)
    if not ok then table.insert(failures, name .. ": " .. tostring(err)) end
    return ok
end

if not safeLoad("main.lua") then
    shared.YokaiCuratedStackV19 = nil
    return
end
safeLoad("NotificationHygieneEarly.lua")
safeLoad("CuratedBootstrap.lua")
safeLoad("SimpleAntiFlingFinal.lua")
safeLoad("UniversalMovementV2.lua")
safeLoad("LocalNoclip.lua")
safeLoad("FinalVisualPolishV4.lua")

-- Wait briefly for the experience-specific client tree without blocking 10+ seconds
-- inside the wrong integration layer.
local Players = game:GetService("Players")
local lp = Players.LocalPlayer
local playerScripts = lp:FindFirstChild("PlayerScripts")
local weaponSystem, gunPlugin = nil, nil
local deadline = os.clock() + 5
repeat
    playerScripts = playerScripts or lp:FindFirstChild("PlayerScripts")
    if playerScripts then
        local client = playerScripts:FindFirstChild("Client")
        local systems = client and client:FindFirstChild("Systems")
        weaponSystem = systems and systems:FindFirstChild("GunSystem")
        local gc = playerScripts:FindFirstChild("GunController")
        local events = gc and gc:FindFirstChild("Events")
        gunPlugin = events and events:FindFirstChild("GunPlugin")
    end
    if weaponSystem or gunPlugin then break end
    task.wait(.1)
until os.clock() >= deadline

-- Local extras are common to both profiles and are intentionally lightweight.
safeLoad("PreservedLocalExtrasV15.lua")

if weaponSystem then
    -- WeaponSystem profile. Combat/weapon integration remains owned by V19.
    -- Visuals are replaced by V20 so Workspace.Players/Zombies/Characters bot rigs
    -- are registered event-by-event instead of repeatedly sweeping the whole map.
    safeLoad("WeaponSystemBotRuntimeV19.lua")
    safeLoad("WeaponSystemFeedbackV19.lua")
    safeLoad("GunTestingBotVisualsV20.lua")
elseif gunPlugin then
    -- GunPlugin profile. V3 remains the known-good gun integration.
    -- Do not load the old BotArenaAdapter or AimViewmodelV2 here: both duplicate
    -- bot scans/work that are already superseded by V3 + the event-driven V20 visuals.
    safeLoad("GunTestingRuntimePolish.lua")
    safeLoad("GunTestingCombatResetV16.lua")
    safeLoad("GunTestingPluginIntegrationV3.lua")
    safeLoad("GunTestingCombatFinalV16.lua")
    safeLoad("QuietBotFeedbackV17.lua")
    safeLoad("LvkReferenceBotAdaptersV18.lua")
    safeLoad("GunTestingBotVisualsV20.lua")
else
    -- Generic NPC fallback keeps the older broad adapter because no game-specific
    -- gun/container structure was detected.
    safeLoad("BotArenaAdapter.lua")
    safeLoad("QuietBotFeedbackV17.lua")
end

shared.YokaiCuratedStackV19 = "loaded"
if #failures > 0 then
    warn("[Yokai] loader completed with " .. tostring(#failures) .. " skipped module(s):\n" .. table.concat(failures, "\n"))
end
